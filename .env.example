# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (project: All In Capital Triage, ap-south-1) ---
NEXT_PUBLIC_SUPABASE_URL=https://xfqaolckblnnnsqtyvse.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dashboard > Project Settings > API keys > secret key. Server-only (seed script, worker).
SUPABASE_SECRET_KEY=

# --- Portkey: every model call goes through it (retries + fallback) ---
PORTKEY_API_KEY=
# Either Portkey virtual keys (preferred) ...
PORTKEY_VK_GEMINI=
PORTKEY_VK_ANTHROPIC=
# ... or raw provider keys passed through Portkey
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Primary (Gemini) and fallback (Claude) model IDs
LLM_PRIMARY_MODEL=
LLM_FALLBACK_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=google/gemini-embedding-001
OPENROUTER_API_KEY=
PORTKEY_BASE_URL=http://localhost:8787/v1

# --- Langfuse: trace per application run, span per step, generation per call ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Research (Phase 2) ---
FIRECRAWL_API_KEY=

# --- Gmail + Calendar OAuth for Riya's account (Phase 3) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Worker ---
WORKER_SECRET=
